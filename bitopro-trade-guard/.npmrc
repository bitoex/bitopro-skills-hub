# bitopro-trade-guard/.npmrc
#
# 這份是 repo 根 .npmrc 的鏡像。當有人從這個子目錄直接跑 npm 指令時，
# npm 會優先讀本檔，不會踩到「根 .npmrc 被誤刪後安全設定失效」的坑。

# 強制公開 npm registry（避免被惡意 registry 劫持）
registry=https://registry.npmjs.org/

# 強制 package.json engines 欄位生效 — Node 版本不對直接擋
engine-strict=true

# 強制 audit；非 high 以上不擋 build，但會印出
audit=true

# 關閉 funding 訊息雜訊
fund=false
